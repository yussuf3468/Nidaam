# Copy to .env.local (development) or set in your host's dashboard (production).

# Public site URL, used for canonical links, sitemap and Open Graph images.
NEXT_PUBLIC_SITE_URL=https://nidaam.co.ke
dd
# Search engine verification codes (just the code, not the whole meta tag).
# Google Search Console: Add property > URL prefix > HTML tag
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools: Add site > HTML Meta Tag
BING_SITE_VERIFICATION=

# Project enquiries from /contact are delivered by email through Resend (https://resend.com).
# Without these, enquiries are only logged in development, and in production the form
# asks visitors to email info@nidaam.co.ke directly instead.
RESEND_API_KEY=
# Sender must be on a domain you have verified in Resend, e.g. "Nidaam Website <website@nidaam.co.ke>"
CONTACT_FROM=
# Where enquiries are delivered
CONTACT_TO=info@nidaam.co.ke
