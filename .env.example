# Copy to .env.local (development) or set in your host's dashboard (production).

# Public site URL, used for canonical links, sitemap and Open Graph images.
NEXT_PUBLIC_SITE_URL=https://nidaam.co.ke

# Search engine verification codes (just the code, not the whole meta tag).
# Google Search Console: Add property > URL prefix > HTML tag
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools: Add site > HTML Meta Tag
BING_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Project enquiries from /contact are emailed to CONTACT_TO.
# Set up ONE of the two options below. Until one is set, "Send enquiry" opens
# the visitor's own email app with the enquiry filled in instead.
# ---------------------------------------------------------------------------

# Where enquiries are delivered
CONTACT_TO=info@nidaam.co.ke
# Optional sender name/address, e.g. "Nidaam Solutions website <info@nidaam.co.ke>"
CONTACT_FROM=

# Option 1: send through your own mailbox (SMTP). Find these in your email provider's settings.
#   Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_PASS = an App Password
#   Microsoft 365:    SMTP_HOST=smtp.office365.com, SMTP_PORT=587
#   cPanel hosting:   SMTP_HOST=mail.nidaam.co.ke, SMTP_PORT=465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Option 2: Resend (https://resend.com). CONTACT_FROM must use a domain verified in Resend.
RESEND_API_KEY=
